generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoReserva {
  pendiente_pago
  pagada
  expirada

  @@map("estado_reserva")
}

enum EstadoPago {
  pendiente
  aprobado
  fallido

  @@map("estado_pago")
}

enum TipoCobro {
  por_persona
  por_hora

  @@map("tipo_cobro")
}

enum TipoQR {
  individual
  grupal

  @@map("tipo_qr")
}

enum TipoCierre {
  mantenimiento
  festivo
  evento_privado

  @@map("tipo_cierre")
}

enum ResultadoAcceso {
  permitido
  rechazado_menor
  qr_invalido
  reserva_no_pagada
  servicio_incorrecto
  fuera_de_horario
  qr_usado

  @@map("resultado_acceso")
}

model Rol {
  id          String    @id @default(uuid()) @db.Uuid
  nombre      String    @unique @db.VarChar(40)
  descripcion String?   @db.VarChar(240)
  activo      Boolean   @default(true)
  usuarios    Usuario[]

  @@map("Rol")
}

model Usuario {
  id                String              @id @default(uuid()) @db.Uuid
  rolId             String              @map("rol_id") @db.Uuid
  nombre            String              @db.VarChar(120)
  correo            String              @unique @db.VarChar(254)
  contrasenaHash    String?             @map("contrasena_hash") @db.VarChar(255)
  proveedorAuth     String              @default("email") @map("proveedor_auth") @db.VarChar(40)
  correoConfirmado  Boolean             @default(false) @map("correo_confirmado")
  cedula            String?             @unique @db.VarChar(30)
  activo            Boolean             @default(true)
  creadoEn          DateTime            @default(now()) @map("creado_en") @db.Timestamptz(6)
  rol               Rol                 @relation(fields: [rolId], references: [id], onDelete: Restrict)
  membresias        Membresia[]
  reservas          Reserva[]           @relation("ClienteReservas")
  terminosAceptados TerminosAceptados[]
  empleado          Empleado?
  cierresCreados    CierreServicio[]    @relation("CierreCreador")

  @@index([rolId, activo])
  @@map("Usuario")
}

model Categoria {
  id        String     @id @default(uuid()) @db.Uuid
  nombre    String     @unique @db.VarChar(80)
  activa    Boolean    @default(true)
  servicios Servicio[]

  @@map("Categoria")
}

model Servicio {
  id                String            @id @default(uuid()) @db.Uuid
  categoriaId       String            @map("categoria_id") @db.Uuid
  nombre            String            @db.VarChar(100)
  descripcion       String            @db.VarChar(500)
  precio            Decimal           @db.Decimal(12, 2)
  tipoCobro         TipoCobro         @map("tipo_cobro")
  capacidadPorHora  Int               @map("capacidad_por_hora")
  capacidadPersonas Int               @default(20) @map("capacidad_personas")
  tipoQr            TipoQR            @map("tipo_qr")
  imagenUrl         String?           @map("imagen_url") @db.VarChar(500)
  activo            Boolean           @default(true)
  categoria         Categoria         @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  horarios          HorarioServicio[]
  cierres           CierreServicio[]
  reservas          Reserva[]
  empleados         Empleado[]
  registrosAcceso   RegistroAcceso[]

  @@index([categoriaId, activo])
  @@map("Servicio")
}

model HorarioServicio {
  id         String   @id @default(uuid()) @db.Uuid
  servicioId String   @map("servicio_id") @db.Uuid
  diaSemana  Int      @map("dia_semana") @db.SmallInt
  horaInicio DateTime @map("hora_inicio") @db.Time(0)
  horaFin    DateTime @map("hora_fin") @db.Time(0)
  activo     Boolean  @default(true)
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@unique([servicioId, diaSemana, horaInicio])
  @@map("HorarioServicio")
}

model Membresia {
  id                  String    @id @default(uuid()) @db.Uuid
  clienteId           String    @map("cliente_id") @db.Uuid
  descuentoPorcentaje Decimal   @map("descuento_porcentaje") @db.Decimal(5, 2)
  fechaInicio         DateTime  @map("fecha_inicio") @db.Date
  fechaFin            DateTime  @map("fecha_fin") @db.Date
  activa              Boolean   @default(true)
  cliente             Usuario   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  reservas            Reserva[]

  @@index([clienteId, activa, fechaInicio, fechaFin])
  @@map("Membresia")
}

model CierreServicio {
  id          String     @id @default(uuid()) @db.Uuid
  servicioId  String     @map("servicio_id") @db.Uuid
  fechaInicio DateTime   @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin    DateTime   @map("fecha_fin") @db.Timestamptz(6)
  motivo      String     @db.VarChar(240)
  tipo        TipoCierre
  creadoPor   String     @map("creado_por") @db.Uuid
  activo      Boolean    @default(true)
  servicio    Servicio   @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  creador     Usuario    @relation("CierreCreador", fields: [creadoPor], references: [id], onDelete: Restrict)

  @@index([servicioId, activo, fechaInicio, fechaFin])
  @@map("CierreServicio")
}

model Empleado {
  id              String           @id @default(uuid()) @db.Uuid
  usuarioId       String           @unique @map("usuario_id") @db.Uuid
  servicioId      String           @map("servicio_id") @db.Uuid
  activo          Boolean          @default(true)
  ultimaActividad DateTime?        @map("ultima_actividad") @db.Timestamptz(6)
  eliminadoEn     DateTime?        @map("eliminado_en") @db.Timestamptz(6)
  usuario         Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  servicio        Servicio         @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  accesos         RegistroAcceso[]

  @@index([servicioId, activo, eliminadoEn])
  @@map("Empleado")
}

model Reserva {
  id                String             @id @default(uuid()) @db.Uuid
  clienteId         String             @map("cliente_id") @db.Uuid
  servicioId        String             @map("servicio_id") @db.Uuid
  membresiaId       String?            @map("membresia_id") @db.Uuid
  fecha             DateTime           @db.Date
  horaInicio        DateTime           @map("hora_inicio") @db.Time(0)
  horaFin           DateTime           @map("hora_fin") @db.Time(0)
  cantidadHoras     Int                @map("cantidad_horas")
  cantidadCupos     Int                @map("cantidad_cupos")
  cantidadPersonas  Int                @default(1) @map("cantidad_personas")
  contieneMenores   Boolean            @default(false) @map("contiene_menores")
  adultoResponsable String?            @map("adulto_responsable") @db.VarChar(120)
  estado            EstadoReserva      @default(pendiente_pago)
  bloqueoExpiraEn   DateTime?          @map("bloqueo_expira_en") @db.Timestamptz(6)
  subtotal          Decimal            @db.Decimal(12, 2)
  descuento         Decimal            @default(0) @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  creadaEn          DateTime           @default(now()) @map("creada_en") @db.Timestamptz(6)
  cliente           Usuario            @relation("ClienteReservas", fields: [clienteId], references: [id], onDelete: Restrict)
  servicio          Servicio           @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  membresia         Membresia?         @relation(fields: [membresiaId], references: [id], onDelete: SetNull)
  terminos          TerminosAceptados?
  pago              Pago?
  codigosQr         CodigoQR[]

  @@index([servicioId, fecha, horaInicio, horaFin, estado])
  @@index([clienteId, fecha, estado])
  @@map("Reserva")
}

model TerminosAceptados {
  id              String   @id @default(uuid()) @db.Uuid
  clienteId       String   @map("cliente_id") @db.Uuid
  reservaId       String   @unique @map("reserva_id") @db.Uuid
  versionTerminos String   @map("version_terminos") @db.VarChar(30)
  aceptadoEn      DateTime @default(now()) @map("aceptado_en") @db.Timestamptz(6)
  cliente         Usuario  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  reserva         Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  @@index([clienteId, aceptadoEn])
  @@map("TerminosAceptados")
}

model Pago {
  id                String     @id @default(uuid()) @db.Uuid
  reservaId         String     @unique @map("reserva_id") @db.Uuid
  stripePaymentId   String?    @unique @map("stripe_payment_id") @db.VarChar(255)
  monto             Decimal    @db.Decimal(12, 2)
  medioPago         String     @map("medio_pago") @db.VarChar(40)
  estado            EstadoPago @default(pendiente)
  fechaPago         DateTime?  @map("fecha_pago") @db.Timestamptz(6)
  nombreComprobante String     @map("nombre_comprobante") @db.VarChar(120)
  cedulaComprobante String     @map("cedula_comprobante") @db.VarChar(30)
  correoComprobante String     @map("correo_comprobante") @db.VarChar(254)
  reserva           Reserva    @relation(fields: [reservaId], references: [id], onDelete: Restrict)

  @@index([estado, fechaPago])
  @@map("Pago")
}

model CodigoQR {
  id        String           @id @default(uuid()) @db.Uuid
  reservaId String           @map("reserva_id") @db.Uuid
  codigo    String           @unique @db.VarChar(255)
  tipo      TipoQR
  usado     Boolean          @default(false)
  fechaUso  DateTime?        @map("fecha_uso") @db.Timestamptz(6)
  reserva   Reserva          @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  accesos   RegistroAcceso[]

  @@map("QR")
}

model RegistroAcceso {
  id          String          @id @default(uuid()) @db.Uuid
  qrId        String?         @map("qr_id") @db.Uuid
  empleadoId  String          @map("empleado_id") @db.Uuid
  servicioId  String          @map("servicio_id") @db.Uuid
  resultado   ResultadoAcceso
  fechaHora   DateTime        @default(now()) @map("fecha_hora") @db.Timestamptz(6)
  codigoLeido String?         @map("codigo_leido") @db.VarChar(255)
  qr          CodigoQR?       @relation(fields: [qrId], references: [id], onDelete: SetNull)
  empleado    Empleado        @relation(fields: [empleadoId], references: [id], onDelete: Restrict)
  servicio    Servicio        @relation(fields: [servicioId], references: [id], onDelete: Restrict)

  @@index([servicioId, fechaHora, resultado])
  @@map("RegistroAcceso")
}
