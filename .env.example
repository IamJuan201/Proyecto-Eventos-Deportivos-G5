# Supabase Project Settings > API: URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<publishable-key>"

# Prisma: transaction pooler (6543) for the app; session pooler (5432) for migrations and seed.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Signs the session cookie. At least 32 characters; generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="<random-32-plus-characters>"

# Protects /api/cron/expire-reservations (the cron sends "Authorization: Bearer <CRON_SECRET>").
# Generate it the same way as SESSION_SECRET. Without it the endpoint answers 503.
CRON_SECRET="<random-32-plus-characters>"

# Wompi sandbox (Colombia: cards, PSE, Nequi). Dashboard: Developers > Secrets.
# Public key used by the Widget checkout (data-public-key).
WOMPI_PUBLIC_KEY="pub_test_<public-key>"
# Integrity secret used to sign the Widget checkout (SHA256 reference + amount + currency + secret).
WOMPI_INTEGRITY_SECRET="test_integrity_<secret>"
# Events secret used to validate POST /api/wompi/webhook (header X-Event-Checksum).
WOMPI_EVENTS_SECRET="test_events_<secret>"
# Public URL used as Wompi redirect-url after payment. Must be https and reachable
# by the browser for the auto-return to work; with http://localhost the checkout
# still works but Wompi shows its own confirmation page instead of redirecting.
APP_URL="http://localhost:3000"

# Resend transactional email (HU-43). Get the key at https://resend.com/api-keys.
# Without it the app still runs; QR emails are logged and skipped.
RESEND_API_KEY="re_<api-key>"
# Verified sender shown in QR and notification emails. Use a domain sender in production.
EMAIL_FROM="Elite Club <no-reply@example.com>"

# Email OTP verification (HU-13): lifetime of the 8-digit code in minutes.
OTP_EXPIRY_MINUTES="15"
# Minimum wait between OTP resends, in minutes.
OTP_RESEND_COOLDOWN_MINUTES="4"
